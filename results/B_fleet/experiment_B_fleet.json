    "seeds": "701001:740001:1000",
    "fleet_configs": [
      {
        "id": "V12R100",
        "vehicles": 12,
        "requests": 100,
        "note": "baseline S4; replicates the 2x2 on fresh seeds"
      },
      {
        "id": "V24R100",
        "vehicles": 24,
        "requests": 100,
        "note": "S3: fleet doubled, identical requests per seed (fleet-size effect at fixed demand)"
      },
      {
        "id": "V24R200",
        "vehicles": 24,
        "requests": 200,
        "note": "fleet and demand doubled: same 8.33 requests per vehicle as V12R100 (scale effect at fixed intensity)"
      }
    ],
