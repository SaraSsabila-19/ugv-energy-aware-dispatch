    given-names: "Saraban"
version: "1.0.0"
date-released: "2026-11-22"
license: MIT
repository-code: "https://github.com/SaraSsabila-19/ugv-energy-aware-dispatch"
keywords:
  - energy-aware dispatch
  - online vehicle assignment
  - electric vehicle fleets
  - ride-pooling
  - simulation
  - reproducibility
